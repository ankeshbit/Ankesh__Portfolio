rules_version = '2';

/**
 * ===============================================================
 * Firestore Security Rules — Portfolio & Visitor Tracking
 * ===============================================================
 * Security Architecture & Validation:
 * 1. Default Deny: All unmatched collections and documents are closed.
 * 2. Role-Based Admin Claims: Admin privileges require custom claims
 *    (request.auth.token.admin == true). No client-side values are trusted.
 * 3. Strict Field Validation:
 *    - users/{userId}:
 *      - Strict key whitelist: uid, displayName, email, photoURL, provider,
 *        createdAt, lastLoginAt, loginCount, lastSeenAt, role.
 *      - Immutable on non-admin update: uid, email, provider, createdAt, role.
 *      - Values: provider in ['google','github','email']; displayName and email <= 256 chars;
 *        photoURL (if present) must be https:// and <= 2048 chars; loginCount must be an int
 *        (1 on create, unchanged or exactly resource.data.loginCount + 1 on update).
 *    - visits/{visitId}:
 *      - Create: exact keys whitelist (uid, visitorName, visitorEmail, startedAt,
 *        lastActivityAt, page, sectionsViewed, userAgent, referrer).
 *      - startedAt == request.time, sectionsViewed size <= 20, userAgent <= 150 chars.
 *      - Update (non-admin): only sectionsViewed and lastActivityAt can change,
 *        with sectionsViewed size <= 20.
 * ===============================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    function isValidUserFields(data) {
      return 'uid' in data && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && 'displayName' in data && data.displayName is string && data.displayName.size() <= 256
        && 'email' in data && data.email is string && data.email.size() <= 256
        && (!('photoURL' in data) || ('photoURL' in data && data.photoURL is string && data.photoURL.size() <= 2048 && data.photoURL.matches('^https://.*')))
        && 'provider' in data && data.provider in ['google', 'github', 'email']
        && (!('role' in data) || data.role == 'visitor')
        && !('admin' in data);
    }

    // ===============================================================
    // Users Collection: users/{userId}
    // ===============================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'provider', 'createdAt', 'lastLoginAt', 'loginCount', 'lastSeenAt', 'role'])
        && isValidUserFields(request.resource.data)
        && 'loginCount' in request.resource.data
        && request.resource.data.loginCount is int
        && request.resource.data.loginCount == 1;

      allow update: if (
        isOwner(userId)
        && resource != null
        && 'email' in resource.data
        && 'provider' in resource.data
        && 'loginCount' in resource.data
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'loginCount', 'lastSeenAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'provider', 'createdAt', 'lastLoginAt', 'loginCount', 'lastSeenAt', 'role'])
        && isValidUserFields(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.provider == resource.data.provider
        && 'loginCount' in request.resource.data
        && request.resource.data.loginCount is int
        && (request.resource.data.loginCount == resource.data.loginCount || request.resource.data.loginCount == resource.data.loginCount + 1)
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Visits Collection: visits/{visitId}
    // ===============================================================
    match /visits/{visitId} {
      allow get: if (isAuthenticated() && resource != null && 'uid' in resource.data && resource.data.uid == request.auth.uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid', 'visitorName', 'visitorEmail', 'startedAt', 'lastActivityAt', 'page', 'sectionsViewed', 'userAgent', 'referrer'])
        && 'uid' in request.resource.data && request.resource.data.uid == request.auth.uid
        && 'startedAt' in request.resource.data && request.resource.data.startedAt == request.time
        && 'lastActivityAt' in request.resource.data && request.resource.data.lastActivityAt is timestamp
        && 'visitorName' in request.resource.data && request.resource.data.visitorName is string && request.resource.data.visitorName.size() <= 256
        && 'visitorEmail' in request.resource.data && request.resource.data.visitorEmail is string && request.resource.data.visitorEmail.size() <= 256
        && 'page' in request.resource.data && request.resource.data.page is string && request.resource.data.page.size() <= 256
        && 'sectionsViewed' in request.resource.data && request.resource.data.sectionsViewed is list && request.resource.data.sectionsViewed.size() <= 20
        && 'userAgent' in request.resource.data && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 150
        && 'referrer' in request.resource.data && request.resource.data.referrer is string && request.resource.data.referrer.size() <= 256;

      allow update: if (
        isAuthenticated()
        && resource != null
        && 'uid' in resource.data
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sectionsViewed', 'lastActivityAt'])
        && 'sectionsViewed' in request.resource.data
        && request.resource.data.sectionsViewed is list
        && request.resource.data.sectionsViewed.size() <= 20
        && 'lastActivityAt' in request.resource.data
        && request.resource.data.lastActivityAt is timestamp
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny Rule
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
